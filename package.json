{
  "name": "mattpocock-skills-for-dsh",
  "version": "0.2.0",
  "description": "Matt Pocock Skills for the DeepSeek Harness: grilling, spec/ticket flows, TDD, and review as an installable bundle plus a portable agent preset.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "preset",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "NOTICE.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "scripts": {
    "install-preset": "node scripts/install-preset.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skills",
    "mattpocock",
    "preset"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Meteor-system",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meteor-system/mattpocock-skills-for-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/Meteor-system/mattpocock-skills-for-dsh/issues"
  },
  "homepage": "https://github.com/Meteor-system/mattpocock-skills-for-dsh#readme"
}
